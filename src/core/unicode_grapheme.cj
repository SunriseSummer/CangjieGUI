private func inUnicodeRanges(codePoint: UInt32, ranges: Array<UInt32>): Bool {
    var low: Int64 = 0
    var high = ranges.size / 2 - 1
    while (low <= high) {
        let mid = (low + high) / 2
        let start = ranges[mid * 2]
        let end = ranges[mid * 2 + 1]
        if (codePoint < start) {
            high = mid - 1
        } else if (codePoint > end) {
            low = mid + 1
        } else {
            return true
        }
    }
    false
}

internal func isUnicodeMark(codePoint: UInt32): Bool {
    // Dominant UI scripts bypass the 310-range binary search. ASCII/Latin below U+0300 cannot be
    // marks, while unified Han ideographs are base characters; mixed CJK paragraphs otherwise pay
    // this lookup once per rune despite never containing a mark.
    if (codePoint < UInt32(0x0300) || (codePoint >= UInt32(0x3400) && codePoint <= UInt32(0x9FFF)) || (codePoint >=
        UInt32(0x20000) && codePoint <= UInt32(0x323AF))) {
        return false
    }
    inUnicodeRanges(codePoint, UNICODE_MARK_RANGES)
}
